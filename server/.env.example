# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://cmg:cmg_dev_password@127.0.0.1:5433/cmg_inventory
# Dev embedded Postgres (npm run db:start)
DEV_DB_PORT=5433
DEV_DB_USER=cmg
DEV_DB_PASSWORD=cmg_dev_password
DEV_DB_NAME=cmg_inventory
# Session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false
# Initial super administrator created by `npm run seed` (must change on first login)
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=Admin@12345
# Password for demo users created by `npm run seed:demo` (development only)
DEMO_USER_PASSWORD=Admin@12345
